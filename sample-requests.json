  {
    "name": "Update Post",
    "method": "PUT",
    "url": "https://jsonplaceholder.typicode.com/posts/1",
    "headers": {
      "Content-Type": "application/json",
      "Accept": "application/json"
    },
    "body": "{\"id\": 1, \"title\": \"Updated Post\", \"body\": \"This is an updated post body\", \"userId\": 1}"
  },
  {
    "name": "Delete Post",
    "method": "DELETE",
    "url": "https://jsonplaceholder.typicode.com/posts/1",
